{
  "name": "yardledger",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "dev": "bash scripts/dev.sh start",
    "dev:clear": "bash scripts/dev.sh start --clear",
    "dev:stop": "bash scripts/dev.sh stop",
    "dev:status": "bash scripts/dev.sh status",
    "dev:reset": "bash scripts/dev.sh reset"
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/spline-sans-mono": "^0.4.2",
    "@expo/metro-runtime": "~55.0.11",
    "@expo/vector-icons": "^15.0.2",
    "@infinitered/react-native-mlkit-text-recognition": "^5.0.1",
    "@nozbe/watermelondb": "^0.28.0",
    "@react-navigation/bottom-tabs": "^7.3.2",
    "@react-navigation/native": "^7.1.3",
    "@react-navigation/native-stack": "^7.3.2",
    "@reduxjs/toolkit": "^2.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "babel-preset-expo": "^55.0.10",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~55.0.5",
    "expo-dev-client": "~55.0.35",
    "expo-file-system": "~55.0.10",
    "expo-font": "~55.0.8",
    "expo-image-picker": "~55.0.20",
    "expo-linking": "~55.0.15",
    "expo-print": "~55.0.15",
    "expo-secure-store": "~55.0.14",
    "expo-sharing": "~55.0.11",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.24",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-document-scanner-plugin": "^2.0.4",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-signature-canvas": "^5.0.2",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^63.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "pg": "^8.22.0",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "shell-quote": "^1.10.0",
    "@babel/runtime": "^7.26.10",
    "uuid": "^11.1.1",
    "@babel/core": "^7.29.7",
    "js-yaml": "^4.3.1",
    "fast-uri": "^3.1.5",
    "react-native": {
      "ws": "^7.5.11"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "private": true
}
